# --- STAGE 1: Hardened PgBouncer Image ---
FROM docker.io/rockylinux/rockylinux:9.7

# 1. Patch vulnerabilities and setup repos (EPEL and PGDG)
RUN dnf clean all && \
    dnf update -y --refresh && \
    dnf install -y epel-release https://download.postgresql.org/pub/repos/yum/reporpms/EL-9-x86_64/pgdg-redhat-repo-latest.noarch.rpm && \
    dnf config-manager --set-enabled crb

# 2. Install PgBouncer, Locales, and Core Diagnostic Utilities
# Incorporates requested tools (vi, top, ps, ping, less) for unified troubleshooting
RUN dnf install -y --allowerasing \
    shadow-utils \
    pgbouncer \
    glibc-langpack-en \
    vim-minimal \
    procps-ng \
    htop \
    iputils \
    less \
    ncurses && \
    dnf clean all

# 3. Create Dedicated Non-Root Runtime User
# Hardens execution by isolating PgBouncer to its own non-privileged system identity
RUN groupadd -g 6432 pgbouncer && \
    useradd -u 6432 -g pgbouncer -M -s /sbin/nologin pgbouncer

# 4. Hardened Directories and Permissions
RUN mkdir -p /etc/pgbouncer /var/log/pgbouncer /run/pgbouncer && \
    chown -R pgbouncer:pgbouncer /etc/pgbouncer /var/log/pgbouncer /run/pgbouncer && \
    chmod 750 /etc/pgbouncer /var/log/pgbouncer /run/pgbouncer

# 5. Environment and Shell Adjustments
ENV LANG=en_US.UTF-8 \
    LANGUAGE=en_US:en \
    LC_ALL=en_US.UTF-8 \
    TERM=xterm-256color

# 6. Copy Runtime Automation Scripts
COPY --chown=pgbouncer:pgbouncer pgbouncer-entrypoint.sh /usr/local/bin/pgbouncer-entrypoint.sh
COPY --chown=pgbouncer:pgbouncer pgbouncer.ini /etc/pgbouncer/pgbouncer.ini.template
RUN chmod +x /usr/local/bin/pgbouncer-entrypoint.sh

# 7. Metadata (OCI Standard)
LABEL org.opencontainers.image.title="Hardened PgBouncer Connection Pooler" \
      org.opencontainers.image.description="Standalone connection pooler optimized for PostgreSQL 18. Built on Rocky Linux 9.7. Includes non-root scaling boundaries and embedded telemetry diagnostics." \
      org.opencontainers.image.vendor="Radix Metasystems"

# 8. Healthcheck
# Validates that PgBouncer is answering internal network control loops
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD psql -p 6432 -U pgbouncer -d pgbouncer -c "SHOW VERSION;" || exit 1

# 9. Runtime Execution Context
USER pgbouncer
WORKDIR /etc/pgbouncer

EXPOSE 6432
ENTRYPOINT ["/usr/local/bin/pgbouncer-entrypoint.sh"]